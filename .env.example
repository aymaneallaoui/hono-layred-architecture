# Shared by every app. Copy to `.env` at the repo root.

# ---------------------------------- apps/api ----------------------------------
NODE_ENV=development
PORT=3001
APP_NAME=Hono Starter
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
# Comma-separated browser origins; defaults to WEB_URL.
# CORS_ORIGINS=http://localhost:5173
# Serve the built SPA from the API (single deployable). Path to apps/web/dist.
# WEB_DIST_DIR=../web/dist
# Apply pending migrations at boot; defaults to true in production.
# MIGRATE_ON_BOOT=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_starter
# DB_POOL_MAX=20
# LOG_LEVEL=debug

# 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-characters
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60
# INVITATION_TTL_DAYS=7

# Optional: with no key, emails are logged to the console.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Acme <hello@acme.com>

# Optional: with no URL, rate limits are per-process in memory.
# REDIS_URL=redis://localhost:6379
# TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SEC=900

# ---------------------------------- apps/web ----------------------------------
VITE_API_URL=http://localhost:3001
