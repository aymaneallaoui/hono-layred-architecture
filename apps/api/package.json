{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./testing/e2e-seed": "./src/testing/e2e-seed.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "start": "NODE_ENV=production bun --env-file=../../.env run src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun --env-file=../../.env test",
    "email": "email dev --dir src/emails --port 3002",
    "db:migrate": "bun --env-file=../../.env run src/migrate.ts latest",
    "db:migrate:up": "bun --env-file=../../.env run src/migrate.ts up",
    "db:migrate:down": "bun --env-file=../../.env run src/migrate.ts down",
    "db:migrate:make": "bun run src/migrate.ts make",
    "build:server": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile dist/server src/index.ts",
    "routes": "bun --env-file=../../.env run src/show-routes.ts",
    "request": "bun --env-file=../../.env run hono request --runtime bun -e bun src/inspect.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "^0.12.1",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.7.2",
    "hono": "^4.13.7",
    "kysely": "^0.29.5",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.26.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/cli": "^0.2.0-next.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "react-email": "^6.9.3",
    "typescript": "^5.9.0"
  }
}
